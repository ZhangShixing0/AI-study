# AI Tutor production environment template

# Production must use PostgreSQL. The app refuses to start with
# APP_ENV=production unless DATABASE_URL is set.
APP_ENV=production

# FastAPI runtime database.
DATABASE_URL=postgresql://ai_tutor_user:CHANGE_ME@127.0.0.1:5432/ai_tutor

# Initial backoffice admin. Clean deployments create loginAccount adm001.
# Required before the first production launch; never reuse this placeholder.
ADMIN_INITIAL_PASSWORD=CHANGEME

# Optional comma-separated origins for a separately hosted frontend.
# Leave empty when Nginx serves the frontend and API from the same origin.
CORS_ALLOWED_ORIGINS=

# Optional override for read-only public seed tables.
# Normally leave empty when public seed tables live in DATABASE_URL.
PUBLIC_SEED_DATABASE_URL=

# Local/testing only: point public seed reads at a SQLite database that contains
# the same public seed tables. Never set this on production.
PUBLIC_SEED_SQLITE_PATH=

# Optional helper for Excel validation/import scripts on Linux servers.
PYTHON_BIN=/opt/ai-tutor/.venv/bin/python
PSQL_BIN=psql

# FastAPI launch example:
# uvicorn backend.main:app --host 127.0.0.1 --port 8000
